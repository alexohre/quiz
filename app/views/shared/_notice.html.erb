<% if notice.present? || alert.present? %>
	<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090; margin-top: 75px; max-width: 420px;">
		<% if notice.present? %>
			<div class="toast align-items-center text-white bg-success border-0 show shadow-lg rounded-4 overflow-hidden mb-2" role="alert" aria-live="assertive" aria-atomic="true">
				<div class="d-flex p-2 align-items-center">
					<div class="toast-body d-flex align-items-center gap-3 fs-6 py-2">
						<i class="bi bi-check-circle-fill fs-3 text-white"></i>
						<div>
							<strong class="d-block text-white" style="font-size: 0.85rem; letter-spacing: 0.5px; text-transform: uppercase;">Success Notice</strong>
							<span style="font-size: 0.95rem; font-weight: 500;"><%= notice %></span>
						</div>
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
				</div>
			</div>
		<% end %>

		<% if alert.present? %>
			<div class="toast align-items-center text-white bg-danger border-0 show shadow-lg rounded-4 overflow-hidden mb-2" role="alert" aria-live="assertive" aria-atomic="true">
				<div class="d-flex p-2 align-items-center">
					<div class="toast-body d-flex align-items-center gap-3 fs-6 py-2">
						<i class="bi bi-exclamation-triangle-fill fs-3 text-white"></i>
						<div>
							<strong class="d-block text-white" style="font-size: 0.85rem; letter-spacing: 0.5px; text-transform: uppercase;">System Alert</strong>
							<span style="font-size: 0.95rem; font-weight: 500;"><%= alert %></span>
						</div>
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
				</div>
			</div>
		<% end %>
	</div>

	<script>
		(function() {
			function autoDismissToasts() {
				setTimeout(function() {
					const toasts = document.querySelectorAll('.toast.show');
					toasts.forEach(function(toast) {
						if (typeof bootstrap !== 'undefined' && bootstrap.Toast) {
							const bsToast = bootstrap.Toast.getOrCreateInstance(toast);
							bsToast.hide();
						} else {
							toast.classList.remove('show');
							toast.style.display = 'none';
						}
					});
				}, 5000);
			}
			document.addEventListener("turbo:load", autoDismissToasts);
			autoDismissToasts();
		})();
	</script>
<% end %>
