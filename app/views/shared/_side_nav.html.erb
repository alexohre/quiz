						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_users_path ? 'active' : ''  %>" href="<%= settings_users_path %>">
						<div class="nav-link-content">
							<i class='bi bi-people-fill me-2'></i>
