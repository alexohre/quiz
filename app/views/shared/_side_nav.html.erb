						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_upload_path ? 'active' : ''  %>" href="<%= settings_upload_path %>">
						<div class="nav-link-content">
							<i class='bi bi-cloud-arrow-up-fill me-2'></i>
							<span>Upload Questions</span>
						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_timer_path ? 'active' : ''  %>" href="<%= settings_timer_path %>">
						<div class="nav-link-content">
							<i class='bi bi-stopwatch-fill me-2'></i>
