<!-- Enhanced Modern Sidebar Navigation -->
<div class="enhanced-sidebar">
	<!-- Sidebar Header -->
	<div class="sidebar-header">
		<div class="brand-section">
			<div class="brand-icon">
				<i class="bx bx-brain fs-2"></i>
			</div>
			<div class="brand-text">
				<h4 class="mb-0 fw-bold">Quiz Admin</h4>
				<small class="text-muted">Management Panel</small>
			</div>
		</div>
