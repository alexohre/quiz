<!-- Enhanced Modern Sidebar Navigation -->
<div class="enhanced-sidebar">
	<!-- Sidebar Header -->
	<div class="sidebar-header">
		<div class="brand-section">
			<div class="brand-icon">
				<i class="bi bi-person-badge-fill fs-3"></i>
			</div>
			<div class="brand-text">
				<h5 class="mb-0 fw-bold text-white">Quiz Admin</h5>
				<small class="text-white-50">Control Panel</small>
			</div>
		</div>
	</div>

	<!-- Main Navigation -->
	<div class="sidebar-content">
		<div class="nav-section">
			<h6 class="nav-section-title">
				<i class="bi bi-gear-fill me-2"></i>
				Configuration
			</h6>
			<ul class="nav-list">
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_settings_path ? 'active' : ''  %>" href="<%= settings_settings_path %>">
						<div class="nav-link-content">
							<i class='bi bi-grid-1x2-fill me-2'></i>
							<span>Settings Overview</span>
						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_stage_path ? 'active' : ''  %>" href="<%= settings_stage_path %>">
						<div class="nav-link-content">
							<i class='bi bi-layers-fill me-2'></i>
							<span>Stage Management</span>
						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_upload_path ? 'active' : ''  %>" href="<%= settings_upload_path %>">
						<div class="nav-link-content">
							<i class='bi bi-cloud-arrow-up-fill me-2'></i>
							<span>Upload Questions</span>
						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_timer_path ? 'active' : ''  %>" href="<%= settings_timer_path %>">
						<div class="nav-link-content">
							<i class='bi bi-stopwatch-fill me-2'></i>
							<span>Timer Settings</span>
						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_users_path ? 'active' : ''  %>" href="<%= settings_users_path %>">
						<div class="nav-link-content">
							<i class='bi bi-people-fill me-2'></i>
							<span>User Management</span>
						</div>
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link <%= request.path == settings_churches_path ? 'active' : ''  %>" href="<%= settings_churches_path %>">
						<div class="nav-link-content">
							<i class='bi bi-building-fill me-2'></i>
							<span>Congregations & Reps</span>
						</div>
					</a>
				</li>
			</ul>
		</div>

		<!-- Data Management Section -->
		<div class="nav-section">
			<h6 class="nav-section-title">
				<i class="bi bi-hdd-stack-fill me-2"></i>
				Data Management
			</h6>
			<ul class="nav-list">
				<li class="nav-item">
					<button type="button" class="nav-link reset-link w-100 text-start border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#resetAnswersModal">
						<div class="nav-link-content">
							<i class='bi bi-arrow-counterclockwise me-2'></i>
							<span>Reset Answers</span>
						</div>
					</button>
				</li>
				<li class="nav-item">
					<button type="button" class="nav-link delete-link w-100 text-start border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#deleteAllDataModal">
						<div class="nav-link-content">
							<i class='bi bi-trash-fill me-2'></i>
							<span>Delete All Data</span>
						</div>
					</button>
				</li>
			</ul>
		</div>
	</div>

	<!-- Sidebar Footer -->
	<div class="sidebar-footer">
		<a class="nav-link home-link" href="/">
			<div class="nav-link-content justify-content-center">
				<i class='bi bi-arrow-left me-2 fs-5'></i>
				<span>Back to Quiz</span>
			</div>
		</a>
	</div>
</div>

<!-- Modal: Delete All Data Confirmation -->
<div class="modal fade" id="deleteAllDataModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow">
			<div class="modal-header border-0 pb-0">
				<h5 class="modal-title fw-bold text-danger">
					<i class="bi bi-exclamation-triangle-fill me-2"></i>Delete All Data
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<%= form_with url: delete_data_path, method: :post do |f| %>
				<div class="modal-body p-4">
					<div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger rounded-3 mb-3">
						<i class="bi bi-shield-slash-fill me-2 fs-5"></i>
						<strong>Warning:</strong> This will permanently delete all questions, scores, stages, congregations, and representatives! This action cannot be undone.
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Type <code class="text-danger fw-bold">delete</code> below to confirm:</label>
						<input type="text" class="form-control form-control-lg rounded-3 fs-6" id="deleteConfirmInput" placeholder="type 'delete' here..." onkeyup="checkConfirmInput('deleteConfirmInput', 'deleteBtnSubmit', 'delete')">
					</div>
				</div>
				<div class="modal-footer border-0 pt-0">
					<button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold" id="deleteBtnSubmit" disabled>
						<i class="bi bi-trash-fill me-1"></i> Delete All Data
					</button>
				</div>
			<% end %>
		</div>
	</div>
</div>

<!-- Modal: Reset Answers Confirmation -->
<div class="modal fade" id="resetAnswersModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow">
			<div class="modal-header border-0 pb-0">
				<h5 class="modal-title fw-bold text-warning-emphasis">
					<i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Reset Answers
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<%= form_with url: reset_path, method: :post do |f| %>
				<div class="modal-body p-4">
					<div class="alert alert-warning bg-warning bg-opacity-10 border-warning border-opacity-25 text-dark rounded-3 mb-3">
						<i class="bi bi-info-circle-fill me-2 fs-5 text-warning"></i>
						This will clear recorded question answers and progress state for the quiz.
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Type <code class="text-warning-emphasis fw-bold">reset</code> below to confirm:</label>
						<input type="text" class="form-control form-control-lg rounded-3 fs-6" id="resetConfirmInput" placeholder="type 'reset' here..." onkeyup="checkConfirmInput('resetConfirmInput', 'resetBtnSubmit', 'reset')">
					</div>
				</div>
				<div class="modal-footer border-0 pt-0">
					<button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-warning text-dark rounded-3 px-4 fw-bold" id="resetBtnSubmit" disabled>
						<i class="bi bi-arrow-counterclockwise me-1"></i> Reset Answers
					</button>
				</div>
			<% end %>
		</div>
	</div>
</div>

<script>
	function checkConfirmInput(inputId, btnId, targetWord) {
		const input = document.getElementById(inputId);
		const btn = document.getElementById(btnId);
		if (input && btn) {
			btn.disabled = (input.value.trim().toLowerCase() !== targetWord.toLowerCase());
		}
	}
</script>