<div class="text-center">
	<% if current_user&.admin? %>
		<%= link_to "Quiz", quiz_index_path, class: "btn btn-primary btn-lg"  %>
		<%= link_to "Quiz Master", quizmaster_path, class: "btn btn-secondary btn-lg"  %>
		<%= link_to "Judges", judges_path, class: "btn btn-success btn-lg"  %>
		<%#= link_to "Scoreboard", scoreboard_path, class: "btn btn-danger btn-lg"  %>
		<%= link_to "Timer", timer_path, class: "btn btn-warning btn-lg"  %>
		<%#= link_to "Record Keeper", timer_path, class: "btn btn-info btn-lg"  %>
	<% elsif current_user&.presenter? %>
		<%= link_to "Quiz", quiz_index_path, class: "btn btn-primary btn-lg"  %>
		<%#= link_to "Scoreboard", scoreboard_path, class: "btn btn-danger btn-lg"  %>
	<% elsif current_user&.time_keeper? %>
		<%= link_to "Timer", timer_path, class: "btn btn-warning btn-lg"  %>
	<% elsif current_user&.judges? %>
		<%= link_to "Judges", judges_path, class: "btn btn-success btn-lg"  %>
	<% elsif current_user&.quiz_master? %>
		<%= link_to "Quiz Master", quizmaster_path, class: "btn btn-secondary btn-lg"  %>
	<% elsif current_user&.recorder? %>
		<%#= link_to "Record Keeper", timer_path, class: "btn btn-info btn-lg"  %>
		<%#= link_to "Scoreboard", scoreboard_path, class: "btn btn-danger btn-lg"  %>
	<% else %>
		Oops...
	<% end %>
</div>
<div class="card my-5 shadow-lg border-0 overflow-hidden">
	<div class="card-body position-relative" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
		<!-- Decorative background pattern -->
		<div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background-image: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.2) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255,255,255,0.2) 0%, transparent 50%);"></div>
		
		<div class="px-4 py-5 my-4 text-center position-relative">
			<!-- Logo with enhanced styling -->
			<div class="mb-4">
				<div class="d-inline-block p-3 bg-white rounded-circle shadow-lg">
					<%= image_tag("jbq.jpg", width: 80, height: 80, alt: "logo", class: "rounded-circle") %>
				</div>
			</div>
			
			<!-- Main heading with improved typography -->
			<h1 class="display-4 fw-bold mb-4 text-white">
				Welcome to the 
				<span class="d-inline-block position-relative">
					<span class="badge bg-danger fs-2 px-3 py-2 rounded-pill shadow-lg pulse-animation" id="buzzer">
						10<sup class="fs-4">th</sup>
					</span>
				</span>
				<br class="d-md-none">
				<span class="text-warning">Children's Bible Quiz</span> Competition
			</h1>
			
			<!-- Decorative divider -->
			<div class="d-flex justify-content-center mb-4">
				<div class="bg-warning rounded-pill" style="width: 60px; height: 4px;"></div>
				<div class="bg-danger rounded-pill mx-2" style="width: 60px; height: 4px;"></div>
				<div class="bg-warning rounded-pill" style="width: 60px; height: 4px;"></div>
			</div>
			
			<!-- Description with better formatting -->
			<div class="col-lg-10 mx-auto">
				<p class="lead mb-4 fs-5 text-white-75" style="line-height: 1.8;">
					This exciting event brings together young minds eager to showcase their knowledge of the Bible. 
					Participants from various backgrounds will engage in friendly competition, answering questions 
					that test their understanding of biblical stories, characters, and teachings.
				</p>
				
				<!-- Additional features badges -->
				<div class="row g-3 mt-4">
					<div class="col-md-4">
						<div class="bg-white bg-opacity-90 rounded-3 p-3 h-100 text-dark shadow-sm">
							<i class="bx bx-brain fs-2 text-primary mb-2"></i>
							<h6 class="fw-bold mb-1 text-dark">Knowledge Testing</h6>
							<small class="text-muted">Comprehensive Bible questions</small>
						</div>
					</div>
					<div class="col-md-4">
						<div class="bg-white bg-opacity-90 rounded-3 p-3 h-100 text-dark shadow-sm">
							<i class="bx bx-group fs-2 text-success mb-2"></i>
							<h6 class="fw-bold mb-1 text-dark">Team Competition</h6>
							<small class="text-muted">Friendly competitive spirit</small>
						</div>
					</div>
					<div class="col-md-4">
						<div class="bg-white bg-opacity-90 rounded-3 p-3 h-100 text-dark shadow-sm">
							<i class="bx bx-trophy fs-2 text-warning mb-2"></i>
							<h6 class="fw-bold mb-1 text-dark">Achievement</h6>
							<small class="text-muted">Recognition and rewards</small>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Add custom CSS for animations -->
<style>
	.pulse-animation {
		animation: pulse 2s infinite;
	}
	
	@keyframes pulse {
		0% {
			transform: scale(1);
			box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
		}
		70% {
			transform: scale(1.05);
			box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
		}
		100% {
			transform: scale(1);
			box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
		}
	}
	
	.text-white-75 {
		color: rgba(255, 255, 255, 0.85) !important;
	}
</style>