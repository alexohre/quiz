<!-- Enhanced Quiz Master Page -->
<div class="quizmaster-page-container">
	<!-- Sleek Compact Quiz Master Header & Live Top-Right Timer -->
	<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 p-3 bg-white shadow-sm rounded-4 border">
		<div class="d-flex align-items-center gap-3">
			<div class="bg-warning bg-opacity-10 text-warning-emphasis p-2.5 rounded-3 d-flex align-items-center justify-content-center">
				<i class="bi bi-crown-fill fs-3 text-warning"></i>
			</div>
			<div>
				<div class="d-flex align-items-center gap-2">
					<h4 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.01em;">Quiz Master</h4>
					<span class="badge bg-warning text-dark rounded-pill fw-bold text-uppercase px-2.5 py-1 small">Host Panel</span>
				</div>
				<small class="text-muted">Live Quiz Control & Questions Center</small>
			</div>
		</div>

		<!-- TOP RIGHT LIVE TIMER (Raw Seconds, No Faded Time Up) -->
		<div class="d-flex align-items-center gap-2 bg-dark text-white px-4 py-2 rounded-pill shadow-sm" data-controller="timer" data-timer-duration="<%= Setting.last&.timer || 30 %>">
			<i class="bi bi-stopwatch-fill fs-5 text-warning"></i>
			<span class="text-white-50 small fw-bold me-1 text-uppercase" style="font-size: 0.75rem;">Timer:</span>
			<span class="fw-extrabold fs-4 font-monospace text-warning me-1" data-timer-target="countdown"><%= Setting.last&.timer || 30 %></span>
		</div>
	</div>

	<!-- Main Content Area -->
	<div id="quiz_content">
		<!-- Question Display Card -->
		<div class="quizmaster-question-display-card">
			<div class="quizmaster-question-header-enhanced">
				<div class="quizmaster-question-badge-enhanced">
					<i class="bi bi-question-circle-fill me-2 fs-4"></i>
					<span class="quizmaster-question-label-enhanced">Question</span>
					<span class="quizmaster-question-number-enhanced">??</span>
				</div>
			</div>
			<div class="quizmaster-question-content-enhanced">
				<div class="quizmaster-awaiting-message">
					<div class="quizmaster-waiting-icon-container">
						<i class="bi bi-mic-fill quizmaster-waiting-icon"></i>
					</div>
					<h3 class="quizmaster-awaiting-text">Awaiting Question</h3>
					<p class="quizmaster-awaiting-subtitle">Ready to host the quiz when question is selected</p>
					<div class="quizmaster-waiting-dots">
						<span class="quizmaster-dot"></span>
						<span class="quizmaster-dot"></span>
						<span class="quizmaster-dot"></span>
					</div>
				</div>
			</div>
		</div>

		<!-- Quiz Master Control Panel -->
		<div class="quizmaster-control-panel">
			<div class="quizmaster-control-card">
				<div class="quizmaster-control-header">
					<i class="bi bi-gear-fill fs-3 me-2 text-warning"></i>
					<h4 class="quizmaster-control-title">Quiz Master Guidelines</h4>
				</div>
				<div class="quizmaster-control-content">
					<div class="row">
						<div class="col-md-6">
							<h5 class="quizmaster-section-title">
								<i class="bi bi-play-circle-fill text-success me-2"></i>
								During Questions
							</h5>
							<ul class="quizmaster-guidelines-list">
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Read questions clearly and slowly</li>
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Allow adequate thinking time</li>
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Maintain audience engagement</li>
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Clarify questions if needed</li>
							</ul>
						</div>
						<div class="col-md-6">
							<h5 class="quizmaster-section-title">
								<i class="bi bi-trophy-fill text-warning me-2"></i>
								Best Practices
							</h5>
							<ul class="quizmaster-guidelines-list">
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Keep energy levels high</li>
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Encourage participation</li>
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Manage time effectively</li>
								<li><i class="bi bi-check-circle-fill text-success me-2"></i>Celebrate correct answers</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Enhanced Quiz Master Page Styles -->
<style>
	.quizmaster-page-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.5rem;
	}

	.quizmaster-question-display-card {
		background: linear-gradient(135deg, #fff8f0, #ffeedd);
		border: 3px solid #ff8c00;
		border-radius: 25px;
		padding: 0;
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
		position: relative;
		overflow: hidden;
		min-height: 350px;
		margin-bottom: 2rem;
	}

	.quizmaster-question-display-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 6px;
		background: linear-gradient(90deg, #ff8c00, #ffc107, #28a745, #007bff, #6f42c1);
	}

	.quizmaster-question-header-enhanced {
		padding: 1.5rem;
		text-align: center;
		border-bottom: 2px solid rgba(255, 140, 0, 0.1);
	}

	.quizmaster-question-badge-enhanced {
		display: inline-flex;
		align-items: center;
		background: linear-gradient(135deg, #ff8c00, #ff6b00);
		color: white;
		padding: 0.6rem 1.8rem;
		border-radius: 50px;
		box-shadow: 0 8px 25px rgba(255, 140, 0, 0.3);
	}

	.quizmaster-question-label-enhanced {
		font-size: 1.25rem;
		font-weight: 600;
		margin-right: 0.75rem;
	}

	.quizmaster-question-number-enhanced {
		font-size: 1.5rem;
		font-weight: 800;
		background: rgba(255, 255, 255, 0.2);
		padding: 0.2rem 0.6rem;
		border-radius: 12px;
	}

	.quizmaster-question-content-enhanced {
		padding: 3rem 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 250px;
	}

	.quizmaster-awaiting-message {
		text-align: center;
	}

	.quizmaster-waiting-icon-container {
		margin-bottom: 1.5rem;
	}

	.quizmaster-waiting-icon {
		font-size: 3.5rem;
		color: #ff8c00;
		animation: bounce 2s infinite;
	}

	.quizmaster-awaiting-text {
		font-size: 2.2rem;
		font-weight: 700;
		color: #495057;
		margin-bottom: 0.5rem;
	}

	.quizmaster-awaiting-subtitle {
		font-size: 1.1rem;
		color: #6c757d;
		margin-bottom: 1.5rem;
	}

	.quizmaster-waiting-dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
	}

	.quizmaster-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #ff8c00;
		animation: pulse-dot 1.5s infinite;
	}

	.quizmaster-dot:nth-child(1) {
		animation-delay: 0s;
	}

	.quizmaster-dot:nth-child(2) {
		animation-delay: 0.3s;
	}

	.quizmaster-dot:nth-child(3) {
		animation-delay: 0.6s;
	}

	.quizmaster-control-panel {
		margin-top: 1.5rem;
	}

	.quizmaster-control-card {
		background: white;
		border-radius: 20px;
		padding: 1.5rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		border: 2px solid #e9ecef;
	}

	.quizmaster-control-header {
		display: flex;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.quizmaster-control-title {
		font-size: 1.3rem;
		font-weight: 600;
		color: #495057;
		margin: 0;
	}

	.quizmaster-section-title {
		font-size: 1.1rem;
		font-weight: 600;
		color: #495057;
		margin-bottom: 0.75rem;
		display: flex;
		align-items: center;
	}

	.quizmaster-guidelines-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.quizmaster-guidelines-list li {
		display: flex;
		align-items: center;
		padding: 0.4rem 0;
		font-size: 0.95rem;
		color: #495057;
		border-bottom: 1px solid #f8f9fa;
	}

	.quizmaster-guidelines-list li:last-child {
		border-bottom: none;
	}

	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(-12px);
		}
		60% {
			transform: translateY(-6px);
		}
	}

	@keyframes pulse-dot {
		0%, 100% {
			opacity: 0.3;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.2);
		}
	}

	@media (max-width: 768px) {
		.quizmaster-awaiting-text {
			font-size: 1.8rem;
		}

		.quizmaster-question-content-enhanced {
			padding: 2rem 1rem;
		}

		.quizmaster-control-card {
			padding: 1.25rem;
		}
	}

	.marquee-container {
		display: flex;
		align-items: center;
	}

	.ticker-marquee-track {
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		animation: marqueeScroll 28s linear infinite;
	}

	.ticker-marquee-track:hover {
		animation-play-state: paused;
	}

	@keyframes marqueeScroll {
		0% { transform: translateX(100%); }
		100% { transform: translateX(-100%); }
	}
</style>
