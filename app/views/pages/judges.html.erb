<!-- Enhanced Judges Page -->
<div class="judges-page-container">
	<!-- Sleek Compact Judges Header & Live Top-Right Timer -->
	<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 p-3 bg-white shadow-sm rounded-4 border">
		<div class="d-flex align-items-center gap-3">
			<div class="bg-primary bg-opacity-10 text-primary p-2.5 rounded-3 d-flex align-items-center justify-content-center">
				<i class="bi bi-patch-check-fill fs-3 text-primary"></i>
			</div>
			<div>
				<div class="d-flex align-items-center gap-2">
					<h4 class="fw-extrabold mb-0 text-dark" style="letter-spacing: -0.01em;">Judges Panel</h4>
					<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-bold text-uppercase px-2.5 py-1 small">Verification</span>
				</div>
				<small class="text-muted">Live Quiz Evaluation & Answer Verification</small>
			</div>
		</div>

		<!-- TOP RIGHT LIVE TIMER (Raw Seconds, No Faded Time Up) -->
		<div class="d-flex align-items-center gap-2 bg-dark text-white px-4 py-2 rounded-pill shadow-sm" data-controller="timer" data-timer-duration="<%= Setting.last&.timer || 30 %>">
			<i class="bi bi-stopwatch-fill fs-5 text-warning"></i>
			<span class="text-white-50 small fw-bold me-1 text-uppercase" style="font-size: 0.75rem;">Timer:</span>
			<span class="fw-extrabold fs-4 font-monospace text-warning me-1" data-timer-target="countdown"><%= Setting.last&.timer || 30 %></span>
		</div>
	</div>

	<!-- Main Content Area -->
	<div id="quiz_content">
		<!-- Question Display Card -->
		<div class="judges-question-display-card">
			<div class="judges-question-header-enhanced">
				<div class="judges-question-badge-enhanced">
					<i class="bi bi-question-circle-fill me-2 fs-4"></i>
					<span class="judges-question-label-enhanced">Question</span>
					<span class="judges-question-number-enhanced">??</span>
				</div>
			</div>
			<div class="judges-question-content-enhanced">
				<div class="judges-awaiting-message">
					<div class="judges-waiting-icon-container">
						<i class="bi bi-hourglass-split judges-waiting-icon"></i>
					</div>
					<h3 class="judges-awaiting-text">Awaiting Question</h3>
					<p class="judges-awaiting-subtitle">Question will appear here when selected</p>
					<div class="judges-waiting-dots">
						<span class="judges-dot"></span>
						<span class="judges-dot"></span>
						<span class="judges-dot"></span>
					</div>
				</div>
			</div>
		</div>

		<!-- Judges Panel Info -->
		<div class="judges-info-panel">
			<div class="judges-info-card">
				<div class="judges-info-header">
					<i class="bi bi-info-circle-fill fs-3 me-2 text-primary"></i>
					<h4 class="judges-info-title">Judges Instructions</h4>
				</div>
				<div class="judges-info-content">
					<ul class="judges-instructions-list">
						<li><i class="bi bi-check-circle-fill text-success me-2"></i>Monitor live quiz questions and answers</li>
						<li><i class="bi bi-check-circle-fill text-success me-2"></i>Evaluate participant responses</li>
						<li><i class="bi bi-check-circle-fill text-success me-2"></i>Ensure fair play and accuracy</li>
						<li><i class="bi bi-check-circle-fill text-success me-2"></i>Provide final scoring decisions</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Enhanced Judges Page Styles -->
<style>
	.judges-page-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.5rem;
	}

	.judges-question-display-card {
		background: linear-gradient(135deg, #f8f9fa, #e9ecef);
		border: 3px solid #6f42c1;
		border-radius: 25px;
		padding: 0;
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
		position: relative;
		overflow: hidden;
		min-height: 350px;
		margin-bottom: 2rem;
	}

	.judges-question-display-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 6px;
		background: linear-gradient(90deg, #6f42c1, #007bff, #28a745, #ffc107, #dc3545);
	}

	.judges-question-header-enhanced {
		padding: 1.5rem;
		text-align: center;
		border-bottom: 2px solid rgba(111, 66, 193, 0.1);
	}

	.judges-question-badge-enhanced {
		display: inline-flex;
		align-items: center;
		background: linear-gradient(135deg, #6f42c1, #5a2d91);
		color: white;
		padding: 0.6rem 1.8rem;
		border-radius: 50px;
		box-shadow: 0 8px 25px rgba(111, 66, 193, 0.3);
	}

	.judges-question-label-enhanced {
		font-size: 1.25rem;
		font-weight: 600;
		margin-right: 0.75rem;
	}

	.judges-question-number-enhanced {
		font-size: 1.5rem;
		font-weight: 800;
		background: rgba(255, 255, 255, 0.2);
		padding: 0.2rem 0.6rem;
		border-radius: 12px;
	}

	.judges-question-content-enhanced {
		padding: 3rem 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 250px;
	}

	.judges-awaiting-message {
		text-align: center;
	}

	.judges-waiting-icon-container {
		margin-bottom: 1.5rem;
	}

	.judges-waiting-icon {
		font-size: 3.5rem;
		color: #6f42c1;
		animation: bounce 2s infinite;
	}

	.judges-awaiting-text {
		font-size: 2.2rem;
		font-weight: 700;
		color: #495057;
		margin-bottom: 0.5rem;
	}

	.judges-awaiting-subtitle {
		font-size: 1.1rem;
		color: #6c757d;
		margin-bottom: 1.5rem;
	}

	.judges-waiting-dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
	}

	.judges-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #6f42c1;
		animation: pulse-dot 1.5s infinite;
	}

	.judges-dot:nth-child(1) {
		animation-delay: 0s;
	}

	.judges-dot:nth-child(2) {
		animation-delay: 0.3s;
	}

	.judges-dot:nth-child(3) {
		animation-delay: 0.6s;
	}

	.judges-info-panel {
		margin-top: 1.5rem;
	}

	.judges-info-card {
		background: white;
		border-radius: 20px;
		padding: 1.5rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		border: 2px solid #e9ecef;
	}

	.judges-info-header {
		display: flex;
		align-items: center;
		margin-bottom: 1.25rem;
	}

	.judges-info-title {
		font-size: 1.3rem;
		font-weight: 600;
		color: #495057;
		margin: 0;
	}

	.judges-instructions-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.judges-instructions-list li {
		display: flex;
		align-items: center;
		padding: 0.5rem 0;
		font-size: 1rem;
		color: #495057;
		border-bottom: 1px solid #f8f9fa;
	}

	.judges-instructions-list li:last-child {
		border-bottom: none;
	}

	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(-12px);
		}
		60% {
			transform: translateY(-6px);
		}
	}

	@keyframes pulse-dot {
		0%, 100% {
			opacity: 0.3;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.2);
		}
	}

	@media (max-width: 768px) {
		.judges-awaiting-text {
			font-size: 1.8rem;
		}

		.judges-question-content-enhanced {
			padding: 2rem 1rem;
		}

		.judges-info-card {
			padding: 1.25rem;
		}
	}
</style>