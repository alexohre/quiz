<div class="row">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- Enhanced Settings Header -->
		<div class="settings-header mb-4">
			<div class="header-badge">
				<i class="bx bx-cog fs-2 me-3"></i>
				<div>
					<h1 class="mb-0">Settings Overview</h1>
					<p class="mb-0 text-muted">Manage your quiz configuration and monitor system status</p>
				</div>
			</div>
		</div>

		<!-- Settings Cards Grid -->
		<div class="row g-4">
			<!-- Available Stages Card -->
			<div class="col-md-6">
				<div class="card h-100 border-0 shadow-sm settings-card">
					<div class="card-header bg-gradient-primary text-white border-0">
						<div class="d-flex align-items-center">
							<i class="bx bx-layer me-2 fs-4"></i>
							<h5 class="mb-0 fw-semibold">Available Stages</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<% if @stages.present? %>
							<div class="stages-container">
								<% @stages.each_with_index do |stage, index| %>
									<div class="stage-item d-flex align-items-center mb-3">
										<div class="stage-number me-3">
											<span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
												<%= index + 1 %>
											</span>
										</div>
										<div class="stage-info flex-grow-1">
											<h6 class="mb-1 fw-semibold text-dark"><%= stage.name %></h6>
											<small class="text-muted">Stage <%= index + 1 %></small>
										</div>
										<div class="stage-status">
											<i class="bx bx-check-circle text-success fs-5"></i>
										</div>
									</div>
								<% end %>
							</div>
							<div class="mt-3 pt-3 border-top">
								<div class="d-flex align-items-center text-success">
									<i class="bx bx-check-circle me-2"></i>
									<span class="fw-semibold"><%= @stages.count %> Stage<%= @stages.count != 1 ? 's' : '' %> Active</span>
								</div>
							</div>
						<% else %>
							<div class="text-center py-4">
								<div class="empty-state-icon mb-3">
									<i class="bx bx-layer text-muted" style="font-size: 3rem;"></i>
								</div>
								<h6 class="text-muted mb-2">No Stages Available</h6>
								<p class="text-muted small mb-0">Create stages to organize your quiz questions</p>
							</div>
						<% end %>
					</div>
				</div>
			</div>

			<!-- Questions Overview Card -->
			<div class="col-md-6">
				<div class="card h-100 border-0 shadow-sm settings-card">
					<div class="card-header bg-gradient-success text-white border-0">
						<div class="d-flex align-items-center">
							<i class="bx bx-help-circle me-2 fs-4"></i>
							<h5 class="mb-0 fw-semibold">Questions Overview</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<% if @stages.present? %>
							<div class="questions-stats mb-4">
								<div class="row text-center">
									<div class="col">
										<div class="stat-card bg-light rounded p-3">
											<h3 class="mb-1 fw-bold text-primary"><%= @stages.sum { |stage| stage.quizzes.count } %></h3>
											<small class="text-muted">Total Questions</small>
										</div>
									</div>
								</div>
							</div>
							<div class="questions-breakdown">
								<h6 class="mb-3 fw-semibold text-dark">Questions by Stage</h6>
								<% @stages.each do |stage| %>
									<div class="question-stage-item d-flex align-items-center justify-content-between mb-3 p-3 bg-light rounded">
										<div class="d-flex align-items-center">
											<div class="stage-icon me-3">
												<i class="bx bx-folder text-primary fs-5"></i>
											</div>
											<div>
												<h6 class="mb-0 fw-semibold"><%= stage.name %></h6>
											</div>
										</div>
										<div class="question-count">
											<span class="badge bg-success fs-6 px-3 py-2">
												<%= stage.quizzes.count %> Question<%= stage.quizzes.count != 1 ? 's' : '' %>
											</span>
										</div>
									</div>
								<% end %>
							</div>
						<% else %>
							<div class="text-center py-4">
								<div class="empty-state-icon mb-3">
									<i class="bx bx-help-circle text-muted" style="font-size: 3rem;"></i>
								</div>
								<h6 class="text-muted mb-2">No Questions Available</h6>
								<p class="text-muted small mb-0">Upload questions to get started with your quiz</p>
							</div>
						<% end %>
					</div>
				</div>
			</div>

			<!-- Timer Configuration Card -->
			<div class="col-md-6">
				<div class="card border-0 shadow-sm settings-card">
					<div class="card-header bg-gradient-warning text-white border-0">
						<div class="d-flex align-items-center">
							<i class="bx bx-timer me-2 fs-4"></i>
							<h5 class="mb-0 fw-semibold">Timer Configuration</h5>
						</div>
					</div>
					<div class="card-body p-4 text-center">
						<div class="timer-display mb-4">
							<div class="timer-circle mx-auto mb-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 rounded-circle" style="width: 120px; height: 120px;">
								<div class="text-center">
									<div class="timer-value text-warning fw-bold" style="font-size: 2.5rem; line-height: 1;">
										<%= @timer.nil? ? 0 : @timer %>
									</div>
									<small class="text-muted fw-semibold">seconds</small>
								</div>
							</div>
						</div>
						<div class="timer-info">
							<h6 class="mb-2 fw-semibold text-dark">Question Timer</h6>
							<p class="text-muted small mb-0">Default time limit for each quiz question</p>
						</div>
					</div>
				</div>
			</div>

			<!-- System Status Card -->
			<div class="col-md-6">
				<div class="card border-0 shadow-sm settings-card">
					<div class="card-header bg-gradient-info text-white border-0">
						<div class="d-flex align-items-center">
							<i class="bx bx-pulse me-2 fs-4"></i>
							<h5 class="mb-0 fw-semibold">System Status</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<div class="status-items">
							<div class="status-item d-flex align-items-center justify-content-between mb-3 p-3 bg-light rounded">
								<div class="d-flex align-items-center">
									<i class="bx bx-server text-success me-3 fs-5"></i>
									<span class="fw-semibold">Quiz System</span>
								</div>
								<span class="badge bg-success">Online</span>
							</div>
							<div class="status-item d-flex align-items-center justify-content-between mb-3 p-3 bg-light rounded">
								<div class="d-flex align-items-center">
									<i class="bx bx-data text-<%= @stages.present? ? 'success' : 'warning' %> me-3 fs-5"></i>
									<span class="fw-semibold">Content</span>
								</div>
								<span class="badge bg-<%= @stages.present? ? 'success' : 'warning' %>">
									<%= @stages.present? ? 'Ready' : 'Pending' %>
								</span>
							</div>
							<div class="status-item d-flex align-items-center justify-content-between p-3 bg-light rounded">
								<div class="d-flex align-items-center">
									<i class="bx bx-time text-<%= @timer && @timer > 0 ? 'success' : 'warning' %> me-3 fs-5"></i>
									<span class="fw-semibold">Timer</span>
								</div>
								<span class="badge bg-<%= @timer && @timer > 0 ? 'success' : 'warning' %>">
									<%= @timer && @timer > 0 ? 'Configured' : 'Default' %>
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Enhanced Settings Page Styles -->
<style>
	.settings-header {
		background: linear-gradient(135deg, #f8f9fa, #e9ecef);
		border-radius: 15px;
		padding: 2rem;
		border: 2px solid #dee2e6;
	}

	.header-badge {
		display: flex;
		align-items: center;
	}

	.header-badge i {
		color: #6f42c1;
	}

	.bg-gradient-primary {
		background: linear-gradient(135deg, #007bff, #0056b3) !important;
	}

	.bg-gradient-success {
		background: linear-gradient(135deg, #28a745, #1e7e34) !important;
	}

	.bg-gradient-warning {
		background: linear-gradient(135deg, #ffc107, #e0a800) !important;
	}

	.bg-gradient-info {
		background: linear-gradient(135deg, #17a2b8, #138496) !important;
	}

	.settings-card {
		transition: all 0.3s ease;
		border-radius: 15px !important;
		overflow: hidden;
	}

	.settings-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
	}

	.settings-card .card-header {
		border-radius: 15px 15px 0 0 !important;
	}

	.stage-item, .question-stage-item, .status-item {
		transition: all 0.2s ease;
		border-radius: 10px !important;
	}

	.stage-item:hover, .question-stage-item:hover, .status-item:hover {
		background-color: #f8f9fa !important;
		transform: translateX(5px);
	}

	.timer-circle {
		transition: all 0.3s ease;
		border: 3px solid #ffc107;
	}

	.timer-circle:hover {
		transform: scale(1.05);
		box-shadow: 0 5px 20px rgba(255, 193, 7, 0.3);
	}

	.empty-state-icon {
		opacity: 0.5;
	}

	.stat-card {
		transition: all 0.2s ease;
	}

	.stat-card:hover {
		background-color: #e9ecef !important;
		transform: scale(1.02);
	}

	@media (max-width: 768px) {
		.settings-card:hover {
			transform: none;
		}
		
		.stage-item:hover, .question-stage-item:hover, .status-item:hover {
			transform: none;
		}
	}
</style>
