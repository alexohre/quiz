<div class="row g-4 align-items-start">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- Settings Header -->
		<div class="settings-header-card mb-4">
			<div class="d-flex align-items-center gap-3">
				<div class="header-icon-box bg-primary bg-opacity-10 text-primary rounded-3 p-3">
					<i class="bi bi-gear-fill fs-1"></i>
				</div>
				<div>
					<h2 class="fw-bold mb-1 text-dark">Settings Overview</h2>
					<p class="text-muted mb-0">Manage quiz configuration, monitor system status, and stages</p>
				</div>
			</div>
		</div>

		<!-- Settings Cards Grid -->
		<div class="row g-4">
			<!-- Available Stages Card -->
			<div class="col-md-6">
				<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden settings-card">
					<div class="card-header bg-primary text-white border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-layers-fill me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">Available Stages</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<% if @stages.present? %>
							<div class="stages-container">
								<% @stages.each_with_index do |stage, index| %>
									<div class="stage-item d-flex align-items-center mb-3 p-2 rounded-3 bg-light">
										<div class="stage-number me-3">
											<span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
												<%= index + 1 %>
											</span>
										</div>
										<div class="stage-info flex-grow-1">
											<h6 class="mb-0 fw-semibold text-dark"><%= stage.name %></h6>
											<small class="text-muted">Stage <%= index + 1 %></small>
										</div>
										<div class="stage-status me-2">
											<i class="bi bi-check-circle-fill text-success fs-5"></i>
										</div>
									</div>
								<% end %>
							</div>
							<div class="mt-3 pt-3 border-top d-flex align-items-center justify-content-between">
								<span class="text-muted small">Configuration Status</span>
								<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold">
									<i class="bi bi-check-lg me-1"></i><%= @stages.count %> Stage<%= @stages.count != 1 ? 's' : '' %> Active
								</span>
							</div>
						<% else %>
							<div class="text-center py-5">
								<div class="empty-state-icon mb-3 text-muted opacity-50">
									<i class="bi bi-layers" style="font-size: 3.5rem;"></i>
								</div>
								<h6 class="text-dark fw-semibold mb-1">No Stages Configured</h6>
								<p class="text-muted small mb-3">Create stages to organize your quiz questions</p>
								<a href="<%= settings_stage_path %>" class="btn btn-sm btn-primary rounded-pill px-4">Create Stages</a>
							</div>
						<% end %>
					</div>
				</div>
			</div>

			<!-- Questions Overview Card -->
			<div class="col-md-6">
				<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden settings-card">
					<div class="card-header bg-success text-white border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-question-circle-fill me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">Questions Overview</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<% if @stages.present? %>
							<div class="questions-stats mb-4">
								<div class="bg-light rounded-4 p-3 text-center border">
									<h2 class="mb-0 fw-bold text-success display-6"><%= @stages.sum { |stage| stage.quizzes.count } %></h2>
									<small class="text-muted fw-semibold">Total Questions Loaded</small>
								</div>
							</div>
							<div class="questions-breakdown">
								<h6 class="mb-3 fw-semibold text-dark small text-uppercase letter-spacing-1">Questions by Stage</h6>
								<% @stages.each do |stage| %>
									<div class="question-stage-item d-flex align-items-center justify-content-between mb-2 p-3 bg-light rounded-3">
										<div class="d-flex align-items-center">
											<div class="stage-icon me-3 text-primary">
												<i class="bi bi-folder-fill fs-5"></i>
											</div>
											<h6 class="mb-0 fw-semibold text-dark"><%= stage.name %></h6>
										</div>
										<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
											<%= stage.quizzes.count %> Qs
										</span>
									</div>
								<% end %>
							</div>
						<% else %>
							<div class="text-center py-5">
								<div class="empty-state-icon mb-3 text-muted opacity-50">
									<i class="bi bi-question-circle" style="font-size: 3.5rem;"></i>
								</div>
								<h6 class="text-dark fw-semibold mb-1">No Questions Available</h6>
								<p class="text-muted small mb-3">Upload CSV files to import questions</p>
								<a href="<%= settings_upload_path %>" class="btn btn-sm btn-success rounded-pill px-4">Upload Questions</a>
							</div>
						<% end %>
					</div>
				</div>
			</div>

			<!-- Timer Configuration Card -->
			<div class="col-md-6">
				<div class="card border-0 shadow-sm rounded-4 overflow-hidden settings-card h-100">
					<div class="card-header bg-warning text-dark border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-stopwatch-fill me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">Timer Configuration</h5>
						</div>
					</div>
					<div class="card-body p-4 text-center d-flex flex-column justify-content-center">
						<div class="timer-display mb-3">
							<div class="timer-circle mx-auto d-flex align-items-center justify-content-center bg-warning bg-opacity-10 rounded-circle border border-warning border-3 shadow-sm" style="width: 110px; height: 110px;">
								<div>
									<div class="timer-value text-warning-emphasis fw-bold fs-1" style="line-height: 1;">
										<%= @timer.nil? ? 0 : @timer %>
									</div>
									<small class="text-muted fw-semibold">seconds</small>
								</div>
							</div>
						</div>
						<h6 class="fw-semibold text-dark mb-1">Question Timer Duration</h6>
						<p class="text-muted small mb-3">Current default countdown for each question</p>
						<div>
							<a href="<%= settings_timer_path %>" class="btn btn-sm btn-outline-warning rounded-pill px-4">Change Duration</a>
						</div>
					</div>
				</div>
			</div>

			<!-- System Status Card -->
			<div class="col-md-6">
				<div class="card border-0 shadow-sm rounded-4 overflow-hidden settings-card h-100">
					<div class="card-header bg-info text-white border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-activity me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">System Health Status</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<div class="status-items">
							<div class="status-item d-flex align-items-center justify-content-between mb-3 p-3 bg-light rounded-3 border">
								<div class="d-flex align-items-center">
									<i class="bi bi-hdd-rack-fill text-success me-3 fs-5"></i>
									<span class="fw-semibold text-dark">Quiz Engine</span>
								</div>
								<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Online</span>
							</div>
							<div class="status-item d-flex align-items-center justify-content-between mb-3 p-3 bg-light rounded-3 border">
								<div class="d-flex align-items-center">
									<i class="bi bi-database-fill text-<%= @stages.present? ? 'success' : 'warning' %> me-3 fs-5"></i>
									<span class="fw-semibold text-dark">Database Content</span>
								</div>
								<span class="badge bg-<%= @stages.present? ? 'success' : 'warning' %>-subtle text-<%= @stages.present? ? 'success' : 'warning' %> border border-<%= @stages.present? ? 'success' : 'warning' %>-subtle px-3 py-1 rounded-pill">
									<%= @stages.present? ? 'Ready' : 'Pending' %>
								</span>
							</div>
							<div class="status-item d-flex align-items-center justify-content-between p-3 bg-light rounded-3 border">
								<div class="d-flex align-items-center">
									<i class="bi bi-wifi text-primary me-3 fs-5"></i>
									<span class="fw-semibold text-dark">Server Network</span>
								</div>
								<code class="badge bg-light text-dark border px-3 py-1 rounded-pill"><%= local_network_address %></code>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
