<div class="row g-4 align-items-start">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- Header Card -->
		<div class="settings-header-card mb-4">
			<div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
				<div class="d-flex align-items-center gap-3">
					<div class="header-icon-box bg-primary bg-opacity-10 text-primary rounded-3 p-3">
						<i class="bi bi-building-fill fs-1"></i>
					</div>
					<div>
						<h2 class="fw-bold mb-1 text-dark">Congregations & Representatives</h2>
						<p class="text-muted mb-0">Manage participating congregations, provinces, and official representatives</p>
					</div>
				</div>
				<div class="d-flex gap-2">
					<button type="button" class="btn btn-outline-primary btn-lg rounded-3 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addChurchModal">
						<i class="bi bi-plus-circle-fill me-1"></i> Add Congregation
					</button>
					<button type="button" class="btn btn-primary btn-lg rounded-3 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addRepModal">
						<i class="bi bi-person-plus-fill me-1"></i> Add Representative
					</button>
				</div>
			</div>
		</div>

		<!-- Summary Statistics Cards -->
		<div class="row g-3 mb-4">
			<div class="col-md-6">
				<div class="stats-card border shadow-sm rounded-4 bg-white">
					<div class="stats-icon bg-primary bg-opacity-10 text-primary">
						<i class="bi bi-building-fill"></i>
					</div>
					<div class="stats-content">
						<h3><%= @churches.count %></h3>
						<p>Participating Congregations</p>
					</div>
				</div>
			</div>
			<div class="col-md-6">
				<div class="stats-card border shadow-sm rounded-4 bg-white">
					<div class="stats-icon bg-success bg-opacity-10 text-success">
						<i class="bi bi-people-fill"></i>
					</div>
					<div class="stats-content">
						<h3><%= @churches.sum { |c| c.representatives.count } %></h3>
						<p>Total Representatives Assigned</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Congregations List -->
		<% if @churches.present? %>
			<div class="row g-4">
				<% @churches.each do |church| %>
					<div class="col-12">
						<div class="card border-0 shadow-sm rounded-4 overflow-hidden settings-card">
							<div class="card-header bg-light border-bottom py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
								<div class="d-flex align-items-center gap-3">
									<div class="avatar-circle bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
										<i class="bi bi-building fs-4"></i>
									</div>
									<div>
										<h5 class="mb-0 fw-bold text-dark"><%= church.name %></h5>
										<% if church.location.present? %>
											<small class="text-muted"><i class="bi bi-geo-alt-fill me-1 text-danger"></i>Province: <strong><%= church.location %></strong></small>
										<% else %>
											<small class="text-muted">Registered Congregation</small>
										<% end %>
									</div>
								</div>
								<div class="d-flex align-items-center gap-2">
									<a href="<%= settings_church_analysis_path(church) %>" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-semibold">
										<i class="bi bi-bar-chart-line-fill me-1"></i> View Report
									</a>
									<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
										<i class="bi bi-people-fill me-1"></i><%= church.representatives.count %> Representative<%= church.representatives.count != 1 ? 's' : '' %>
									</span>
									<button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addRepForChurchModal<%= church.id %>">
										<i class="bi bi-plus-lg me-1"></i> Add Rep
									</button>
									<%= button_to delete_church_path(church), method: :delete, data: { turbo_confirm: "Are you sure you want to delete congregation '#{church.name}' and all its representatives?" }, class: "btn btn-sm btn-outline-danger rounded-pill px-3" do %>
										<i class="bi bi-trash-fill"></i>
									<% end %>
								</div>
							</div>
							<div class="card-body p-4">
								<% if church.representatives.present? %>
									<div class="table-responsive">
										<table class="table table-hover align-middle mb-0" style="font-size: 0.92rem;">
											<thead class="bg-light text-muted small text-uppercase">
												<tr>
													<th class="ps-3 py-2">Representative Name</th>
													<th class="py-2">Role / Title</th>
													<th class="py-2">Contact Info</th>
													<th class="text-end pe-3 py-2">Action</th>
												</tr>
											</thead>
											<tbody>
												<% church.representatives.each do |rep| %>
													<tr>
														<td class="ps-3 py-2">
															<div class="d-flex align-items-center">
																<div class="avatar-circle me-2 bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
																	<%= rep.name.first.upcase %>
																</div>
																<span class="fw-semibold text-dark"><%= rep.name %></span>
															</div>
														</td>
														<td class="py-2">
															<span class="badge bg-light text-dark border px-3 py-1 rounded-pill"><%= rep.role.presence || "Representative" %></span>
														</td>
														<td class="py-2">
															<% if rep.phone.present? %>
																<small class="text-muted"><i class="bi bi-telephone me-1"></i><%= rep.phone %></small>
															<% else %>
																<small class="text-muted">—</small>
															<% end %>
														</td>
														<td class="text-end pe-3 py-2">
															<%= button_to delete_representative_path(rep), method: :delete, data: { turbo_confirm: "Remove representative #{rep.name}?" }, class: "btn btn-sm btn-link text-danger p-0" do %>
																<i class="bi bi-x-circle-fill fs-5"></i>
															<% end %>
														</td>
													</tr>
												<% end %>
											</tbody>
										</table>
									</div>
								<% else %>
									<div class="text-center py-4 bg-light rounded-3 border border-dashed">
										<p class="text-muted mb-2 small"><i class="bi bi-person-exclamation me-1"></i> No representatives assigned to this congregation yet.</p>
										<button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addRepForChurchModal<%= church.id %>">
											<i class="bi bi-plus-lg me-1"></i> Assign Representative
										</button>
									</div>
								<% end %>
							</div>
						</div>
					</div>

					<!-- Modal: Add Representative for specific congregation -->
					<div class="modal fade" id="addRepForChurchModal<%= church.id %>" tabindex="-1" aria-hidden="true">
						<div class="modal-dialog modal-dialog-centered">
							<div class="modal-content rounded-4 border-0 shadow">
								<div class="modal-header border-0 pb-0">
									<h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Add Representative</h5>
									<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
								</div>
								<%= form_with url: create_representative_path, method: :post do |f| %>
									<div class="modal-body p-4">
										<%= f.hidden_field :church_id, value: church.id %>
										<div class="mb-3">
											<label class="form-label fw-semibold text-dark">Congregation</label>
											<input type="text" class="form-control form-control-lg rounded-3 bg-light fs-6" value="<%= church.name %>" readonly disabled>
										</div>
										<div class="mb-3">
											<label class="form-label fw-semibold text-dark">Representative Full Name</label>
											<%= f.text_field :name, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. John Doe", required: true %>
										</div>
										<div class="mb-3">
											<label class="form-label fw-semibold text-dark">Role / Title</label>
											<%= f.text_field :role, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. Youth Leader / Coach" %>
										</div>
										<div class="mb-3">
											<label class="form-label fw-semibold text-dark">Phone Number (Optional)</label>
											<%= f.text_field :phone, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. +1 234 567 890" %>
										</div>
									</div>
									<div class="modal-footer border-0 pt-0">
										<button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
										<button type="submit" class="btn btn-primary rounded-3 px-4">Save Representative</button>
									</div>
								<% end %>
							</div>
						</div>
					</div>
				<% end %>
			</div>
		<% else %>
			<div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
				<div class="empty-state-icon mb-3 text-muted opacity-50">
					<i class="bi bi-building" style="font-size: 3.5rem;"></i>
				</div>
				<h5 class="fw-bold text-dark mb-1">No Congregations Registered Yet</h5>
				<p class="text-muted small mb-4">Add participating congregations and provinces to organize official representatives.</p>
				<div>
					<button type="button" class="btn btn-primary btn-lg rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addChurchModal">
						<i class="bi bi-plus-circle-fill me-1"></i> Add First Congregation
					</button>
				</div>
			</div>
		<% end %>
	</div>
</div>

<!-- Modal: Add Congregation -->
<div class="modal fade" id="addChurchModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow">
			<div class="modal-header border-0 pb-0">
				<h5 class="modal-title fw-bold text-dark"><i class="bi bi-building-add me-2 text-primary"></i>Add Congregation</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<%= form_with url: create_church_path, method: :post do |f| %>
				<div class="modal-body p-4">
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Congregation Name</label>
						<%= f.text_field :name, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. St. Mark Assembly", required: true %>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Province (Optional)</label>
						<%= f.text_field :location, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. Western Province" %>
					</div>
				</div>
				<div class="modal-footer border-0 pt-0">
					<button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary rounded-3 px-4">Create Congregation</button>
				</div>
			<% end %>
		</div>
	</div>
</div>

<!-- Modal: Add Representative (General) -->
<div class="modal fade" id="addRepModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow">
			<div class="modal-header border-0 pb-0">
				<h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Add Representative</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<%= form_with url: create_representative_path, method: :post do |f| %>
				<div class="modal-body p-4">
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Select Congregation</label>
						<%= f.collection_select :church_id, Church.all.order(name: :asc), :id, :name, 
							{ prompt: "Select Congregation..." }, 
							{ class: "form-select form-select-lg rounded-3 fs-6", required: true } %>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Representative Full Name</label>
						<%= f.text_field :name, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. Jane Doe", required: true %>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Role / Title</label>
						<%= f.text_field :role, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. Quiz Coach" %>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Phone Number (Optional)</label>
						<%= f.text_field :phone, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "e.g. +1 555 0192" %>
					</div>
				</div>
				<div class="modal-footer border-0 pt-0">
					<button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary rounded-3 px-4">Add Representative</button>
				</div>
			<% end %>
		</div>
	</div>
</div>
