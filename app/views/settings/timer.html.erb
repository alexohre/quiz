<div class="row g-4 align-items-start">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- Timer Settings Header -->
		<div class="timer-settings-header mb-4">
			<div class="d-flex align-items-center gap-3">
				<div class="header-icon-box bg-warning bg-opacity-10 text-warning-emphasis rounded-3 p-3">
					<i class="bi bi-stopwatch-fill fs-1"></i>
				</div>
				<div>
					<h2 class="fw-bold mb-1 text-dark">Timer & Scoring Settings</h2>
					<p class="text-muted mb-0">Configure default question countdown timer, points per question, and auto-start behavior</p>
				</div>
			</div>
		</div>

		<!-- Configuration Card -->
		<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
			<div class="card-header bg-warning text-dark border-0 py-3 px-4">
				<div class="d-flex align-items-center">
					<i class="bi bi-sliders me-2 fs-5"></i>
					<h5 class="mb-0 fw-semibold">Timer & Scoring Rules</h5>
				</div>
			</div>
			<div class="card-body p-4">
				<%= form_with model: @timers, url: settings_timer_path, method: :post, class: "timer-form" do |f| %>
					<div class="row g-4">
						<!-- Timer Duration -->
						<div class="col-md-4">
							<div class="mb-3">
								<label for="timer_field" class="form-label fw-semibold text-dark">
									<i class="bi bi-alarm-fill fs-5 me-1 text-warning"></i>
									Timer Duration (Seconds)
								</label>
								<div class="input-group input-group-lg">
									<span class="input-group-text bg-light border-end-0">
										<i class="bi bi-clock text-muted"></i>
									</span>
									<%= f.number_field :timer, 
											value: @timer, 
											class: "form-control border-start-0 fs-5", 
											id: "timer_field",
											min: 1,
											max: 3600,
											placeholder: "60" %>
									<span class="input-group-text bg-light">sec</span>
								</div>
								<div class="form-text text-muted mt-2">
									Current: <strong><%= @timer || 60 %></strong> seconds
								</div>
							</div>
						</div>

						<!-- Points Per Question -->
						<div class="col-md-4">
							<div class="mb-3">
								<label for="points_field" class="form-label fw-semibold text-dark">
									<i class="bi bi-star-fill fs-5 me-1 text-success"></i>
									Points Per Question
								</label>
								<div class="input-group input-group-lg">
									<span class="input-group-text bg-light border-end-0">
										<i class="bi bi-award text-muted"></i>
									</span>
									<%= f.number_field :points_per_question, 
											value: @points_per_question, 
											class: "form-control border-start-0 fs-5", 
											id: "points_field",
											min: 1,
											max: 500,
											placeholder: "10" %>
									<span class="input-group-text bg-light">pts</span>
								</div>
								<div class="form-text text-muted mt-2">
									Default score increment per correct question: <strong><%= @points_per_question || 10 %></strong> pts
								</div>
							</div>
						</div>

						<!-- Auto Start -->
						<div class="col-md-4">
							<div class="mb-3">
								<label class="form-label fw-semibold text-dark">
									<i class="bi bi-play-circle-fill fs-5 me-1 text-primary"></i>
									Auto-Start Behavior
								</label>
								<div class="bg-light border rounded-3 p-3 d-flex align-items-center" style="min-height: 48px;">
									<div class="form-check form-switch mb-0 d-flex align-items-center gap-3 w-100 ps-0">
										<%= f.check_box :auto_start, 
												checked: @auto_start, 
												class: "form-check-input fs-4 m-0 cursor-pointer ms-0", 
												id: "auto_start_switch",
												style: "float: none; width: 2.8em; height: 1.4em;" %>
										<label class="form-check-label fw-semibold text-dark cursor-pointer small mb-0 lh-sm" for="auto_start_switch">
											Auto-start timer on question load
										</label>
									</div>
								</div>
								<div class="form-text text-muted mt-2">
									Automatically start countdown when question opens
								</div>
							</div>
						</div>
					</div>

					<div class="mt-4 pt-3 border-top">
						<button type="submit" class="btn btn-warning btn-lg px-5 rounded-3 fw-semibold shadow-sm">
							<i class="bi bi-check-lg me-1"></i> Save Settings
						</button>
					</div>
				<% end %>
			</div>
		</div>
	</div>
</div>
