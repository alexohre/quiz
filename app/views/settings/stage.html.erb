<div class="row g-4 align-items-start">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- Stage Management Header -->
		<div class="stage-settings-header mb-4">
			<div class="d-flex align-items-center gap-3">
				<div class="header-icon-box bg-primary bg-opacity-10 text-primary rounded-3 p-3">
					<i class="bi bi-layers-fill fs-1"></i>
				</div>
				<div>
					<h2 class="fw-bold mb-1 text-dark">Stage Management</h2>
					<p class="text-muted mb-0">Configure the number of quiz stages for your competition</p>
				</div>
			</div>
		</div>

		<div class="row g-4">
			<!-- Current Stage Status Card -->
			<div class="col-md-6">
				<div class="card border-0 shadow-sm stage-card h-100 rounded-4 overflow-hidden">
					<div class="card-header bg-primary text-white border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-check-circle-fill me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">Current Configuration</h5>
						</div>
					</div>
					<div class="card-body p-4 text-center d-flex flex-column justify-content-center">
						<div class="stage-display mb-3">
							<div class="stage-circle mx-auto d-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle border border-primary border-3 shadow-sm" style="width: 120px; height: 120px;">
								<div>
									<div class="stage-value text-primary fw-bold display-4" style="line-height: 1;">
										<%= @stage || 0 %>
									</div>
									<small class="text-muted fw-semibold">stages</small>
								</div>
							</div>
						</div>
						<h6 class="mb-1 fw-semibold text-dark">Active Stages Count</h6>
						<p class="text-muted small mb-0">
							<% if @stage && @stage > 0 %>
								Your quiz is configured with <strong><%= @stage %> stage<%= @stage != 1 ? 's' : '' %></strong>
							<% else %>
								No stages configured yet
							<% end %>
						</p>
					</div>
				</div>
			</div>

			<!-- Stage Configuration Form Card -->
			<div class="col-md-6">
				<div class="card border-0 shadow-sm stage-card h-100 rounded-4 overflow-hidden">
					<div class="card-header bg-success text-white border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-pencil-square me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">Update Stages</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<%= form_with url: settings_stage_path, method: :post, html: {class: "stage-form"} do |f| %>
							<div class="mb-4">
								<label for="number_of_stages" class="form-label fw-semibold text-dark">
									<i class="bi bi-hash me-1 text-success"></i>
									Number of Stages
								</label>
								<div class="input-group input-group-lg">
									<span class="input-group-text bg-light border-end-0">
										<i class="bi bi-layers text-muted"></i>
									</span>
									<%= f.number_field :number_of_stages, 
										class: "form-control border-start-0 fs-5", 
										id: "number_of_stages",
										placeholder: "Enter number...",
										min: 1,
										max: 20,
										value: @stage,
										required: true %>
								</div>
								<div class="form-text text-muted mt-2">
									<i class="bi bi-info-circle me-1"></i>
									Recommended: 1-10 stages for optimal event flow
								</div>
							</div>

							<button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-semibold">
								<i class="bi bi-check-lg me-1"></i> Save Stages
							</button>
						<% end %>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
