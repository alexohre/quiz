<div class="row g-4 align-items-start">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- User Management Header -->
		<div class="user-settings-header mb-4">
			<div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
				<div class="d-flex align-items-center gap-3">
					<div class="header-icon-box bg-primary bg-opacity-10 text-primary rounded-3 p-3">
						<i class="bi bi-people-fill fs-1"></i>
					</div>
					<div>
						<h2 class="fw-bold mb-1 text-dark">User Management</h2>
						<p class="text-muted mb-0">Manage quiz users, roles, and security credentials</p>
					</div>
				</div>
				<button type="button" class="btn btn-primary btn-lg rounded-3 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
					<i class="bi bi-person-plus-fill me-1"></i> Add New User
				</button>
			</div>
		</div>

		<!-- User Statistics Cards -->
		<div class="row g-3 mb-4">
			<div class="col-md-4">
				<div class="stats-card border shadow-sm rounded-4 bg-white">
					<div class="stats-icon bg-primary bg-opacity-10 text-primary">
						<i class="bi bi-person-fill"></i>
					</div>
					<div class="stats-content">
						<h3><%= @users.count %></h3>
						<p>Total Users</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="stats-card border shadow-sm rounded-4 bg-white">
					<div class="stats-icon bg-success bg-opacity-10 text-success">
						<i class="bi bi-shield-lock-fill"></i>
					</div>
					<div class="stats-content">
						<h3><%= @users.where(role: 'admin').count %></h3>
						<p>Administrators</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="stats-card border shadow-sm rounded-4 bg-white">
					<div class="stats-icon bg-info bg-opacity-10 text-info">
						<i class="bi bi-person-check-fill"></i>
					</div>
					<div class="stats-content">
						<h3><%= @users.where.not(role: 'admin').count %></h3>
						<p>Staff & Officials</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Users Table Card -->
		<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
			<div class="card-header bg-dark text-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
				<div class="d-flex align-items-center">
					<i class="bi bi-table me-2 fs-5"></i>
					<h5 class="mb-0 fw-semibold">User Accounts Directory</h5>
				</div>
				<span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-bold"><%= @users.count %> Active Accounts</span>
			</div>
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
						<thead class="bg-light text-muted small text-uppercase">
							<tr>
								<th class="ps-4 py-3">User</th>
								<th class="py-3">Role</th>
								<th class="py-3">Password</th>
								<th class="text-end pe-4 py-3">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% @users.each do |user| %>
								<tr>
									<td class="ps-4 py-3">
										<div class="d-flex align-items-center">
											<div class="avatar-circle me-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
												<%= user.email.first.upcase %>
											</div>
											<div>
												<div class="fw-semibold text-dark"><%= user.email %></div>
												<small class="text-muted">ID: #<%= user.id %></small>
											</div>
										</div>
									</td>
									<td class="py-3">
										<span class="badge bg-<%= user.admin? ? 'danger' : 'success' %>-subtle text-<%= user.admin? ? 'danger' : 'success' %> border border-<%= user.admin? ? 'danger' : 'success' %>-subtle px-3 py-1 rounded-pill fw-semibold">
											<%= user.role.to_s.titleize %>
										</span>
									</td>
									<td class="py-3">
										<code class="bg-light px-2 py-1 rounded text-dark"><%= user.visible_password.presence || "••••••••" %></code>
									</td>
									<td class="text-end pe-4 py-3">
										<div class="d-inline-flex gap-2">
											<button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editPasswordModal<%= user.id %>">
												<i class="bi bi-key-fill me-1"></i> Password
											</button>
											<% unless user == current_user %>
												<%= button_to delete_user_path(user), method: :delete, data: { turbo_confirm: "Are you sure you want to delete user #{user.email}?" }, class: "btn btn-sm btn-outline-danger rounded-pill px-3" do %>
													<i class="bi bi-trash-fill me-1"></i> Delete
												<% end %>
											<% end %>
										</div>
									</td>
								</tr>

								<!-- Password Modal for each user -->
								<div class="modal fade" id="editPasswordModal<%= user.id %>" tabindex="-1" aria-hidden="true">
									<div class="modal-dialog modal-dialog-centered">
										<div class="modal-content rounded-4 border-0 shadow">
											<div class="modal-header border-0 pb-0">
												<h5 class="modal-title fw-bold text-dark"><i class="bi bi-key-fill me-2 text-primary"></i>Update Password</h5>
												<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
											</div>
											<%= form_with url: update_user_password_path, method: :post do |f| %>
												<div class="modal-body p-4">
													<%= f.hidden_field :user_id, value: user.id %>
													<p class="text-muted small">Update password for account <strong><%= user.email %></strong></p>
													<div class="mb-3">
														<label class="form-label fw-semibold text-dark">New Password</label>
														<%= f.password_field :password, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "Enter new password", required: true %>
													</div>
												</div>
												<div class="modal-footer border-0 pt-0">
													<button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
													<button type="submit" class="btn btn-primary rounded-3 px-4">Update Password</button>
												</div>
											<% end %>
										</div>
									</div>
								</div>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow">
			<div class="modal-header border-0 pb-0">
				<h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Add New User</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<%= form_with url: create_user_path, method: :post do |f| %>
				<div class="modal-body p-4">
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Email Address</label>
						<%= f.email_field :email, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "user@example.com", required: true %>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">Password</label>
						<%= f.password_field :password, class: "form-control form-control-lg rounded-3 fs-6", placeholder: "Enter password", required: true %>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold text-dark">User Role</label>
						<%= f.select :role, [
								['Administrator', 'admin'],
								['Presenter', 'presenter'],
								['Time Keeper', 'time_keeper'],
								['Judge', 'judges'],
								['Quiz Master', 'quiz_master'],
								['Recorder', 'recorder']
							], {}, { class: "form-select form-select-lg rounded-3 fs-6", required: true } %>
					</div>
				</div>
				<div class="modal-footer border-0 pt-0">
					<button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary rounded-3 px-4">Create Account</button>
				</div>
			<% end %>
		</div>
	</div>
</div>