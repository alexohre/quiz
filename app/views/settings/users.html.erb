<div class="row">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- Enhanced Header Card -->
		<div class="user-settings-header mb-4">
			<div class="d-flex justify-content-between align-items-center">
				<div class="header-badge">
					<i class="bx bx-user-plus fs-1 me-3"></i>
					<div>
						<h2 class="mb-1">User Management</h2>
						<p class="mb-0 text-muted">Manage quiz participants and administrators</p>
					</div>
				</div>
				<button type="button" class="btn btn-primary btn-lg add-user-btn" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
					<i class="bx bx-plus me-2"></i>
					Add New User
				</button>
			</div>
		</div>

		<!-- User Statistics Cards -->
		<div class="row mb-4">
			<div class="col-md-4">
				<div class="stats-card">
					<div class="stats-icon bg-primary">
						<i class="bx bx-user"></i>
					</div>
					<div class="stats-content">
						<h3><%= @users.count %></h3>
						<p>Total Users</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="stats-card">
					<div class="stats-icon bg-success">
						<i class="bx bx-shield-check"></i>
					</div>
					<div class="stats-content">
						<h3><%= @users.where(role: 'admin').count %></h3>
						<p>Administrators</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="stats-card">
					<div class="stats-icon bg-info">
						<i class="bx bx-user-check"></i>
					</div>
					<div class="stats-content">
						<h3><%= @users.where(role: 'participant').count %></h3>
						<p>Participants</p>
					</div>
				</div>
			</div>
		</div>
		<!-- Enhanced Users Table -->
		<div class="users-table-card">
			<div class="table-header">
				<h4 class="mb-0">
					<i class="bx bx-table me-2"></i>
					User Directory
				</h4>
				<div class="table-actions">
					<div class="search-box">
						<i class="bx bx-search"></i>
						<input type="text" id="userSearch" placeholder="Search users..." class="form-control">
					</div>
				</div>
			</div>
			<div class="table-responsive">
				<table class="table enhanced-table">
					<thead>
						<tr>
							<th scope="col">
								<div class="th-content">
									<i class="bx bx-hash me-1"></i>
									#
								</div>
							</th>
							<th scope="col">
								<div class="th-content">
									<i class="bx bx-envelope me-1"></i>
									Email Address
								</div>
							</th>
							<th scope="col">
								<div class="th-content">
									<i class="bx bx-lock me-1"></i>
									Password
								</div>
							</th>
							<th scope="col">
								<div class="th-content">
									<i class="bx bx-shield me-1"></i>
									Role
								</div>
							</th>
							<th scope="col">
								<div class="th-content">
									<i class="bx bx-network-chart me-1"></i>
									Last IP
								</div>
							</th>
							<th scope="col">
								<div class="th-content">
									<i class="bx bx-wifi me-1"></i>
									Current IP
								</div>
							</th>
							<th scope="col">
								<div class="th-content">
									<i class="bx bx-cog me-1"></i>
									Actions
								</div>
							</th>
						</tr>
					</thead>
					<tbody>
						<% @users.each_with_index do |user, index| %>
							<tr class="user-row">
								<td>
									<div class="user-index">
										<%= index + 1 %>
									</div>
								</td>
								<td>
									<div class="user-email">
										<i class="bx bx-user-circle me-2 text-primary"></i>
										<span><%= user.email %></span>
									</div>
								</td>
								<td>
									<div class="password-display">
										<code class="password-code"><%= user.visible_password %></code>
									</div>
								</td>
								<td>
									<span class="role-badge <%= user.role == 'admin' ? 'role-admin' : 'role-participant' %>">
										<i class="bx <%= user.role == 'admin' ? 'bx-shield-check' : 'bx-user' %> me-1"></i>
										<%= user.role.capitalize %>
									</span>
								</td>
								<td>
									<div class="ip-address">
										<%= user.last_sign_in_ip || '-' %>
									</div>
								</td>
								<td>
									<div class="ip-address">
										<%= user.current_sign_in_ip || '-' %>
									</div>
								</td>
								<td>
									<div class="action-buttons">
										<button type="button" class="btn btn-outline-primary btn-sm action-btn" data-user-id="<%= user.id%>" data-user-email="<%= user.email %>" data-bs-toggle="modal" data-bs-target="#staticBackdrop11" title="Reset Password">
											<i class='bx bx-key'></i>
										</button>
										<% if current_user&.admin? && current_user != user %>
											<%= link_to delete_user_url(user), data: {turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this user?"}, class: "btn btn-outline-danger btn-sm action-btn", title: "Delete User" do %>
												<i class='bx bx-trash'></i>
											<% end %>
										<% else %>
											<span class="current-user-indicator" title="Current User">
												<i class='bx bx-user-check text-success'></i>
											</span>
										<% end %>
									</div>
								</td>
							</tr>
						<% end %>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<!-- Enhanced Add User Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content enhanced-modal">
			<!-- Enhanced Modal Header -->
			<div class="modal-header enhanced-modal-header">
				<div class="modal-header-content">
					<div class="modal-icon">
						<i class="bx bx-user-plus"></i>
					</div>
					<div class="modal-title-section">
						<h1 class="modal-title" id="staticBackdropLabel">Add New User</h1>
						<p class="modal-subtitle">Create a new user account with role assignment</p>
					</div>
				</div>
				<button type="button" class="btn-close enhanced-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			
			<%= form_with(url: create_user_path, method: :post, local: true, data: {turbo: false}) do |form| %>
				<!-- Enhanced Modal Body -->
				<div class="modal-body enhanced-modal-body">
					<div class="form-section">
						<div class="unified-form-card">
							<div class="form-group-enhanced">
								<div class="input-group-inline">
									<div class="input-icon">
										<i class="bx bx-envelope"></i>
									</div>
									<div class="input-content">
										<%= form.label :email, class: "form-label-enhanced" %>
										<%= form.email_field :email, class: "form-control-enhanced", placeholder: "Enter user email address", required: true %>
									</div>
								</div>
							</div>
							
							<div class="form-group-enhanced">
								<div class="input-group-inline">
									<div class="input-icon">
										<i class="bx bx-lock-alt"></i>
									</div>
									<div class="input-content">
										<%= form.label :password, class: "form-label-enhanced" %>
										<%= form.password_field :password, class: "form-control-enhanced", placeholder: "Create a secure password (min. 6 characters)", required: true, minlength: 6 %>
										<div class="password-hint">
											<small class="text-muted">Password must be at least 6 characters long</small>
										</div>
									</div>
								</div>
							</div>
							
							<div class="form-group-enhanced">
								<div class="input-group-inline">
									<div class="input-icon">
										<i class="bx bx-shield-check"></i>
									</div>
									<div class="input-content">
										<%= form.label :role, class: "form-label-enhanced" %>
										<%= form.select :role, User.roles.keys.map { |role| [role.humanize, role] }, { prompt: "Select user role..."}, class: "form-select-enhanced", required: true%>
										<div class="role-description">
											<small class="text-muted">Choose the appropriate access level for this user</small>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Enhanced Modal Footer -->
				<div class="modal-footer enhanced-modal-footer">
					<button type="button" class="btn btn-outline-secondary enhanced-btn-secondary" data-bs-dismiss="modal">
						<i class="bx bx-x me-2"></i>Cancel
					</button>
					<%= form.submit "Create User", class: "btn btn-primary enhanced-btn-primary" %>
				</div>
			<% end %>
		</div>
	</div>
</div>
<!-- Enhanced Update Password Modal -->
<div class="modal fade" id="staticBackdrop11" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel11" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content enhanced-modal">
			<!-- Enhanced Modal Header -->
			<div class="modal-header enhanced-modal-header">
				<div class="modal-header-content">
					<div class="modal-icon password-icon">
						<i class="bx bx-key"></i>
					</div>
					<div class="modal-title-section">
						<h1 class="modal-title" id="staticBackdropLabel11">Update Password</h1>
						<p class="modal-subtitle">Reset password for selected user account</p>
					</div>
				</div>
				<button type="button" class="btn-close enhanced-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			
			<!-- User Info Section -->
			<div class="user-info-section">
				<div class="user-badge">
					<div class="user-avatar">
						<i class="bx bx-user"></i>
					</div>
					<div class="user-details">
						<span class="user-email" id="visibleUserEmail"></span>
						<small class="text-muted">User Account</small>
					</div>
				</div>
			</div>
			
			<%= form_with(url: update_user_password_path, method: :post, local: true, data: {turbo: false}) do |form| %>
				<!-- Enhanced Modal Body -->
				<div class="modal-body enhanced-modal-body">
					<%= form.hidden_field :user_id, id: "hiddenUserId" %>
					
					<div class="form-section">
						<div class="form-group-enhanced">
							<div class="input-group-wrapper">
								<div class="input-icon">
									<i class="bx bx-lock-alt"></i>
								</div>
								<div class="input-content">
									<%= form.label :new_password, "New Password", class: "form-label-enhanced" %>
									<%= form.password_field :password, class: "form-control-enhanced", placeholder: "Enter new secure password", required: true, minlength: 6 %>
									<div class="password-requirements">
										<small class="text-muted">
											<i class="bx bx-check-circle me-1"></i>Minimum 6 characters required
										</small>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Enhanced Modal Footer -->
				<div class="modal-footer enhanced-modal-footer">
					<button type="button" class="btn btn-outline-secondary enhanced-btn-secondary" data-bs-dismiss="modal">
						<i class="bx bx-x me-2"></i>Cancel
					</button>
					<%= form.submit "Update Password", class: "btn btn-warning enhanced-btn-warning" %>
				</div>
			<% end %>
		</div>
	</div>
</div>
<script>
	document.addEventListener("turbo:load", function () {
		var modal = document.getElementById('staticBackdrop11');
			modal.addEventListener('show.bs.modal', function (event) {
				// Button that triggered the modal
					var button = event.relatedTarget;
					// Extract info from data-* attributes
					var userId = button.getAttribute('data-user-id');
					var userEmail = button.getAttribute('data-user-email');
					// Update the hidden input value
					var hiddenUserIdInput = document.getElementById('hiddenUserId');
					var visibleUserEmail = document.getElementById('visibleUserEmail');
					hiddenUserIdInput.value = userId;
					visibleUserEmail.textContent = userEmail;
			});
		});
</script>

<!-- Enhanced Users Page Styles -->
