<div class="row g-4 align-items-start">
	<div class="col-lg-3">
		<%= render 'shared/side_nav' %>
	</div>
	<div class="col-lg-9">
		<!-- Upload Questions Header -->
		<div class="upload-settings-header mb-4">
			<div class="d-flex align-items-center gap-3">
				<div class="header-icon-box bg-success bg-opacity-10 text-success rounded-3 p-3">
					<i class="bi bi-cloud-arrow-up-fill fs-1"></i>
				</div>
				<div>
					<h2 class="fw-bold mb-1 text-dark">Upload Questions</h2>
					<p class="text-muted mb-0">Import quiz questions from CSV files to populate stages</p>
				</div>
			</div>
		</div>

		<div class="row g-4">
			<!-- Upload Form Card -->
			<div class="col-lg-7">
				<div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
					<div class="card-header bg-success text-white border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-upload me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">Question Upload</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<%= form_with url: settings_uploader_path, method: :post, local: true, multipart: true, html: {class: "upload-form", id: "questionUploadForm"} do |form| %>
							<!-- Stage Selection -->
							<div class="mb-4">
								<label for="stage_id" class="form-label fw-semibold text-dark">
									<i class="bi bi-layers-fill me-1 text-primary"></i>
									Target Stage
								</label>
								<%= form.collection_select :stage_id, Stage.all.order(id: :asc), :id, :name, 
									{ prompt: "Select a target stage" }, 
									{ class: "form-select form-select-lg rounded-3 fs-6", id: "stage_id", required: true } %>
							</div>

							<!-- Number Start -->
							<div class="mb-4">
								<label for="number_start" class="form-label fw-semibold text-dark">
									<i class="bi bi-hash me-1 text-info"></i>
									Starting Question Number
								</label>
								<div class="input-group input-group-lg">
									<span class="input-group-text bg-light border-end-0">
										<i class="bi bi-hash text-muted"></i>
									</span>
									<%= form.number_field :number_start, 
										class: "form-control border-start-0 fs-6", 
										id: "number_start",
										placeholder: "1",
										min: 1,
										required: true %>
								</div>
							</div>

							<!-- File Selection -->
							<div class="mb-4">
								<label for="file" class="form-label fw-semibold text-dark">
									<i class="bi bi-file-earmark-spreadsheet-fill me-1 text-success"></i>
									CSV File
								</label>
								<%= form.file_field :file, 
									class: "form-control form-control-lg rounded-3 fs-6", 
									id: "file",
									accept: ".csv",
									required: true %>
								<div class="form-text text-muted mt-2">
									<i class="bi bi-info-circle me-1"></i>
									Must be a valid .csv format file
								</div>
							</div>

							<button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-semibold">
								<i class="bi bi-cloud-arrow-up-fill me-1"></i> Import CSV Questions
							</button>
						<% end %>
					</div>
				</div>
			</div>

			<!-- Format Guide Card -->
			<div class="col-lg-5">
				<div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-light">
					<div class="card-header bg-dark text-white border-0 py-3 px-4">
						<div class="d-flex align-items-center">
							<i class="bi bi-book-fill me-2 fs-5"></i>
							<h5 class="mb-0 fw-semibold">CSV Format Guide</h5>
						</div>
					</div>
					<div class="card-body p-4">
						<p class="text-muted small">Your CSV file must include headers matching this layout:</p>
						<div class="p-3 bg-white rounded-3 border mb-3">
							<code class="text-dark small d-block mb-1 fw-bold">Question,Answer</code>
							<code class="text-muted small d-block">"Who built the ark?","Noah"</code>
							<code class="text-muted small d-block">"Where was Jesus born?","Bethlehem"</code>
						</div>
						<ul class="list-unstyled text-muted small mb-0">
							<li class="mb-2"><i class="bi bi-check-circle-fill text-success me-1"></i> <strong>Header row</strong> is required</li>
							<li class="mb-2"><i class="bi bi-check-circle-fill text-success me-1"></i> Ensure UTF-8 text encoding</li>
							<li><i class="bi bi-check-circle-fill text-success me-1"></i> Questions auto-sequence from start number</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
