<% if quiz %>
	<div id="quiz_<%= quiz.id %>">
		<!-- Enhanced Question Section -->
		<div class="broadcast-question-container mb-4">
			<div class="broadcast-question-card position-relative">
				<div class="broadcast-question-badge-corner">
					<i class="bx bx-help-circle me-1"></i>
					<span class="broadcast-question-label-small">Question <%= quiz.formatted_question_number %></span>
				</div>
				<div class="broadcast-question-text">
					<%= quiz.question %>
				</div>
			</div>
		</div>
		
		<!-- Enhanced Answer Section -->
		<div class="broadcast-answer-container mb-4">
			<div class="broadcast-answer-card position-relative">
				<div class="broadcast-answer-badge-corner">
					<i class="bx bx-check-circle me-1"></i>
					<span class="broadcast-answer-label-small">Answer</span>
				</div>
				<div class="broadcast-answer-text">
					<%= quiz.answer %>
				</div>
			</div>
		</div>
	</div>
<% end %>

<!-- Enhanced Quiz Broadcast Styles -->
<style>
	.broadcast-question-container,
	.broadcast-answer-container {
		margin-bottom: 2rem;
	}
	
	.broadcast-question-card {
		background: linear-gradient(135deg, #f8f9fa, #e9ecef);
		border: 3px solid #007bff;
		border-radius: 20px;
		padding: 3rem 2rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		position: relative;
		overflow: hidden;
	}
	
	.broadcast-question-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 5px;
		background: linear-gradient(90deg, #007bff, #28a745, #ffc107, #dc3545);
	}
	
	.broadcast-answer-card {
		background: linear-gradient(135deg, #f0fff4, #e8f5e8);
		border: 3px solid #28a745;
		border-radius: 20px;
		padding: 3rem 2rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		position: relative;
		overflow: hidden;
	}
	
	.broadcast-answer-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 5px;
		background: linear-gradient(90deg, #28a745, #20c997, #17a2b8, #007bff);
	}
	
	.broadcast-question-badge-corner {
		position: absolute;
		top: -10px;
		right: 20px;
		display: inline-flex;
		align-items: center;
		background: linear-gradient(135deg, #007bff, #0056b3);
		color: white;
		padding: 0.5rem 1rem;
		border-radius: 25px;
		box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
		z-index: 10;
		font-size: 1rem;
		font-weight: 600;
	}
	
	.broadcast-answer-badge-corner {
		position: absolute;
		top: -10px;
		right: 20px;
		display: inline-flex;
		align-items: center;
		background: linear-gradient(135deg, #28a745, #1e7e34);
		color: white;
		padding: 0.5rem 1rem;
		border-radius: 25px;
		box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
		z-index: 10;
		font-size: 1rem;
		font-weight: 600;
	}
	
	.broadcast-question-label-small,
	.broadcast-answer-label-small {
		font-size: 1rem;
		font-weight: 600;
	}
	
	.broadcast-question-text {
		font-size: 2.5rem;
		font-weight: 700;
		color: #212529;
		text-align: center;
		line-height: 1.3;
		margin: 0;
	}
	
	.broadcast-answer-text {
		font-size: 2.5rem;
		font-weight: 700;
		color: #155724;
		text-align: center;
		line-height: 1.3;
		margin: 0;
	}
	
	@media (max-width: 768px) {
		.broadcast-question-card,
		.broadcast-answer-card {
			padding: 2rem 1rem;
		}
		
		.broadcast-question-text,
		.broadcast-answer-text {
			font-size: 1.8rem;
		}
	}
</style>
