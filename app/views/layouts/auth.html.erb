<!DOCTYPE html>
<html>
	<head>
		<title>Children Bible Quiz Auth</title>
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<meta name="turbo-prefetch" content="false">
		<%= csrf_meta_tags %>
		<%= csp_meta_tag %>
		<%= favicon_link_tag "cbq.png" %>
		<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
		<%= javascript_importmap_tags "application" %>
	</head>
	<style>
		.bg-gradient-app {
			background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 35%, #f3e8ff 70%, #faf5ff 100%);
			background-attachment: fixed;
			min-height: 100vh;
		}
		html, body {
			min-height: 100vh;
			margin: 0;
			padding: 0;
			overflow-x: hidden;
		}
	</style>
	<body class="bg-gradient-app">
		<%= yield %>
	</body>
</html>
